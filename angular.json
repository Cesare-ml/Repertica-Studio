{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "repertica-studio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "rp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/repertica-studio",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ],
            "assets": [{ "glob": "**/*.svg", "input": "src/assets/icons", "output": "assets/icons" }]
          },
          "configurations": {
            "production": {
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "repertica-studio:build:production"
            },
            "development": {
              "buildTarget": "repertica-studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
